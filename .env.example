# Configuração do backend UniDANFE SaaS

APP_NAME=UniDANFE
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# PostgreSQL (Neon/Railway/Render)
# Local: sqlite+aiosqlite:///./danfe_facil.db
# Neon:  postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://danfe:danfe123@localhost:5432/danfe_facil

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (preencha em produção)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_PRO=price_pro_xxxxxxxx
STRIPE_PRICE_BUSINESS=price_business_xxxxxxxx

# SMTP (deixe vazio se usar Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Resend (recomendado para email transacional)
RESEND_API_KEY=
EMAIL_FROM=UniDANFE <noreply@seu-dominio.com>

FREE_PROCESS_LIMIT=10